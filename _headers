# Security + caching headers (Cloudflare Pages / Netlify format).
# Start with the Report-Only CSP, open the app, check the browser console for "Content Security Policy" messages,
# then rename the header to Content-Security-Policy to enforce it. Add your PROXY URL to connect-src.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https://tiles.openfreemap.org https://*.wikimedia.org https://places.googleapis.com https://*.googleusercontent.com https://*.fbcdn.net https://*.mapillary.com; connect-src 'self' https://tiles.openfreemap.org https://photon.komoot.io https://nominatim.openstreetmap.org https://overpass-api.de https://overpass.kumi.systems https://overpass.private.coffee https://routing.openstreetmap.de https://commons.wikimedia.org https://en.wikipedia.org https://www.wikidata.org https://graph.mapillary.com https://places.googleapis.com; worker-src 'self' blob:; child-src blob:; font-src 'self' data:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/privacy.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/icons/*
  Cache-Control: public, max-age=2592000
